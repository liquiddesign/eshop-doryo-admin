{
    "name": "liquiddesign/eshop-doryo-admin",
    "description": "Zápis do administrace e-shopu pro Doryo/Kolego — headless spouštění admin presenterů: gridy ke čtení, formuláře a akce s náhledem a tokenem, hromadné úpravy",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "liquiddesign/eshop-doryo-api": "^1.12",
        "liquiddesign/admin": "^2.1",
        "liquiddesign/grid": "^1.0",
        "liquiddesign/forms": "^3.0",
        "liquiddesign/security": "^2.0",
        "liquiddesign/storm": "^2.0",
        "nette/application": "^3.2",
        "nette/component-model": "^3.1",
        "nette/di": "^3.1",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/schema": "^1.2",
        "nette/security": "^3.1",
        "nette/utils": "^4.0",
        "latte/latte": "^3.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*"
    },
    "autoload": {
        "psr-4": {
            "DoryoAdmin\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "liquiddesign/codestyle": "^3.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-nette": "^1.3"
    },
    "scripts": {
        "phpcs": "phpcs --standard=ruleset.xml --cache ./src",
        "phpcsfix": "phpcbf --standard=ruleset.xml --cache ./src",
        "phpstan": "phpstan analyse --memory-limit 2G -c phpstan.neon",
        "check-code": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
